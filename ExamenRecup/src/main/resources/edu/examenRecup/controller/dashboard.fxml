<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.layout.*?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.examenRecup.controller.DashboardController"
            prefHeight="400.0" prefWidth="600.0">

    <top>
        <HBox spacing="10.0">
            <Label fx:id="lblWelcome"
                   alignment="CENTER_LEFT"/>
            <Button fx:id="btnLogout"
                    text="Logout"
                    onAction="#handleLogout"
                    alignment="CENTER_RIGHT"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
            <FlowPane fx:id="flowUsuarios"
                      hgap="15"
                      vgap="15"
                      style="-fx-padding: 20;"/>
        </ScrollPane>
    </center>
    <right>
        <VBox fx:id="panelAdmin"
              spacing="10"
              prefWidth="280"
              style="-fx-padding: 15;">

            <Label text="Admin Control Panel"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <Label text="Manage User"
                   style="-fx-font-weight: bold;"/>

            <Label text="ID (Read only for edit):"/>
            <TextField fx:id="txtId"
                       editable="false"/>

            <Label text="Nombre:"/>
            <TextField fx:id="txtNombre"/>

            <Label text="Nickname:"/>
            <TextField fx:id="txtNickname"/>

            <Label text="Email:"/>
            <TextField fx:id="txtEmail"/>

            <TextField></TextField>
        </VBox>
    </right>
</BorderPane>
